# Copy to .env.local and adjust. Every value is optional for local development.
# See docs/DEPLOY.md for Vercel and Turso.

# Database. A local SQLite file by default. Vercel cannot keep a local file, so use a hosted
# libSQL/Turso database there.
# DATABASE_URL=file:data/helpdesk.db
# DATABASE_URL=libsql://your-database.turso.io
# DATABASE_AUTH_TOKEN=

# Demo mode (default on): the first run seeds demo users and sample data, the login page lists the
# demo accounts and their password, and managers get a "Reset demo data" button.
# Set to 0 for real use.
# DEMO_MODE=0

# Demo mode only: password for the seeded demo accounts. Change it before a public deploy, since
# the login page prints it.
# DEMO_PASSWORD=helpdesk-demo

# DEMO_MODE=0 only: the first run creates this manager account (and no demo data). Both are
# required, and the password needs at least 8 characters. Used once, on the first request.
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=

# Public address of the deployed app. REQUIRED in production for password reset emails, because links
# are built from it. (Building them from the request's Host header would let an attacker poison them.)
# APP_URL=https://your-app.vercel.app

# Email for password reset, through Resend (https://resend.com). Both are needed, and the sender must be
# a domain you have verified with Resend. Without them: development stores mail on /dev/outbox, and
# production turns password reset off (the "Forgot your password?" link disappears).
# RESEND_API_KEY=
# MAIL_FROM="HelpDesk <no-reply@your-domain.com>"

# Secret that protects /api/cron/maintenance (escalation and closing old resolved tickets). Set it on Vercel
# (Settings, Environment Variables) and Vercel Cron sends it automatically. Without it the endpoint returns 404.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CRON_SECRET=
