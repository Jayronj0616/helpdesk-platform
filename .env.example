# Copy to .env.local and adjust. Every value is optional for local development.

# Database. A local SQLite file by default; use a hosted libSQL/Turso database to deploy.
# DATABASE_URL=file:data/helpdesk.db
# DATABASE_URL=libsql://your-database.turso.io
# DATABASE_AUTH_TOKEN=

# Demo mode (default on). Shows the demo accounts on the login page and enables "Reset demo data".
# Set to 0 for anything that is not a public demo.
# DEMO_MODE=0

# Password given to the seeded demo accounts the first time the database is created.
# Change this before deploying, since the login page prints it while DEMO_MODE is on.
# DEMO_PASSWORD=helpdesk-demo
