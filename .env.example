# Copy to .env.local and adjust. Every value is optional for local development.
# See docs/DEPLOY.md for Vercel and Turso.

# Database. A local SQLite file by default. Vercel cannot keep a local file, so use a hosted
# libSQL/Turso database there.
# DATABASE_URL=file:data/helpdesk.db
# DATABASE_URL=libsql://your-database.turso.io
# DATABASE_AUTH_TOKEN=

# Demo mode (default on): the first run seeds demo users and sample data, the login page lists the
# demo accounts and their password, and managers get a "Reset demo data" button.
# Set to 0 for real use.
# DEMO_MODE=0

# Demo mode only: password for the seeded demo accounts. Change it before a public deploy, since
# the login page prints it.
# DEMO_PASSWORD=helpdesk-demo

# DEMO_MODE=0 only: the first run creates this manager account (and no demo data). Both are
# required, and the password needs at least 8 characters. Used once, on the first request.
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=
